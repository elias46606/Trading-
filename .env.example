# Kopiere diese Datei nach .env und fülle die Werte aus.

# PostgreSQL — kostenlos z.B. bei https://neon.tech (Connection String kopieren).
# Fürs lokale Basteln ohne Postgres: siehe Hinweis in prisma/schema.prisma (SQLite).
DATABASE_URL="postgresql://user:passwort@host/datenbank?sslmode=require"

# Schutz für die /api/cron-Route beim kostenlosen Vercel-Hosting (DEPLOY.md).
# Irgendein selbst ausgedachtes Passwort/Wort.
CRON_SECRET=""

# Phase 2 — Telegram-Alerts (optional, ohne diese Werte werden Alerts nur in der DB geloggt)
# 1. Bei @BotFather in Telegram einen Bot erstellen -> Token hier eintragen
# 2. Dem Bot eine Nachricht schicken, dann https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen -> chat.id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Phase 4 — KI-Copilot (optional, ohne Key ist das Copilot-Panel deaktiviert)
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=""

# Nur für den Dauer-Worker (npm run worker bzw. EMBEDDED_WORKER=true) relevant.
# Beim Vercel-Hosting übernimmt /api/cron das Timing.
INGEST_INTERVAL_SECONDS="60"
DISPATCH_INTERVAL_SECONDS="45"
